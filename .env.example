# Shared community (Supabase). Placeholders only; copy to .env (ignored by Git) and fill in.
# Run the app with: node --env-file=.env server.mjs
# Browser-safe values only. Never put a secret / service-role key here.
COMMUNITY_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
COMMUNITY_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
# Optional: UUID of the community to open by default (defaults to the seeded demonstration community).
# COMMUNITY_ID=b10c0000-0000-4000-8000-000000000001

# Integration tests only (test/community-access.integration.mjs). Server-side secret: never served to browsers.
# COMMUNITY_SUPABASE_SECRET_KEY=sb_secret_YOUR_KEY
